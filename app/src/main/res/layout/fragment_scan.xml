<?xml version="1.0" encoding="utf-8"?>
<!-- FILE: app/src/main/res/layout/fragment_scan.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apk_scanner"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Scanner Animation + Progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="20dp"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <!-- Gear icon (spinning) -->
        <ImageView
            android:id="@+id/iv_scanner_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_gear"
            android:layout_marginBottom="16dp"/>

        <!-- Status text -->
        <TextView
            android:id="@+id/tv_scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_prompt"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/scan_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="@color/neon_green"
            android:progressBackgroundTint="@color/bg_secondary"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="8dp"/>

        <!-- Progress text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_current_app"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="►"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:ellipsize="middle"
                android:singleLine="true"/>

            <TextView
                android:id="@+id/tv_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scanned"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_scanned_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/neon_cyan"
                android:textSize="28sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/threat"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_threat_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/neon_green"
                android:textSize="28sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_threats"
                android:textColor="@color/text_dim"
                android:textSize="8sp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tv_active_threats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/neon_cyan"
                android:textSize="28sp"
                android:fontFamily="monospace"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Scan Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_start_scan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/scan_system"
            android:textColor="@color/bg_primary"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:backgroundTint="@color/neon_green"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_pause_resume"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="⏸"
            android:textSize="20sp"
            android:textColor="@color/bg_primary"
            android:fontFamily="monospace"
            android:backgroundTint="@color/neon_cyan"
            android:visibility="invisible"/>
    </LinearLayout>

    <!-- Engine loading warning (yellow) -->
    <TextView
        android:id="@+id/tv_engine_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/engine_loading_warning"
        android:textColor="@color/warning_orange"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:padding="8dp"
        android:background="@drawable/bg_card"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- Found Threats List -->
    <TextView
        android:id="@+id/tv_threat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/found_threats"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Bulk actions: select all + delete selected -->
    <LinearLayout
        android:id="@+id/bulk_actions_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <CheckBox
            android:id="@+id/cb_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/select_all"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:buttonTint="@color/neon_cyan"/>

        <Button
            android:id="@+id/btn_delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/delete_selected"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:enabled="false"
            android:backgroundTint="@color/threat_red"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_threats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible"/>

</LinearLayout>
