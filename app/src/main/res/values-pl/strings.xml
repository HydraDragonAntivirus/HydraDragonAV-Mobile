    <string name="debug_mode_warning_title">Debugowanie USB jest wlaczone</string>
    <string name="debug_mode_warning_msg">Debugowanie USB/bezprzewodowe (ADB) jest wlaczone. Podlaczony komputer lub inne autoryzowane urzadzenie moze w ten sposób wysylac dane wejsciowe, pobierac dane aplikacji lub instalowac aplikacje — wylacz to, jesli teraz tego nie potrzebujesz.</string>
